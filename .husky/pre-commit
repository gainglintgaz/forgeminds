#!/usr/bin/env sh
# ForgeMinds pre-commit hook
#
# Mechanical enforcement of VIBE Rule 35 + Phase 5.5 Audit Gate.
# Discipline failed three times on Phase 0; this hook is why it won't again.
#
# Gates (each blocks the commit if it fails):
#   1. tsc --noEmit on the whole project (catches what Vite skips).
#   2. verify:columns on staged files in src/app/api/ or src/lib/pipeline/.
#   3. Secret-pattern grep on staged files.
#   4. ESLint on staged TS/TSX files.
#
# The AUDIT GATE wording check (require AUDIT GATE block in message body
# when subject uses done|complete|finished|ship|deploy) lives in
# .husky/commit-msg — it's the only hook that receives the message file
# path. Pre-2026-05-07 the check lived here and silently never fired
# because pre-commit doesn't get $1; the discipline was decoration.
# Discovered while running P1.0-E.
#
# Skip with --no-verify ONLY if Victor has explicitly approved bypassing the hook.

set -eu

red()    { printf '\033[31m%s\033[0m\n' "$1"; }
green()  { printf '\033[32m%s\033[0m\n' "$1"; }
yellow() { printf '\033[33m%s\033[0m\n' "$1"; }

# ──────────────────────────────────────────────────────────────────────
# 1. tsc --noEmit (project-wide; catches column drift in `as`-cast contexts
#    that Vite/Turbopack skip)
# ──────────────────────────────────────────────────────────────────────
echo "▶ tsc --noEmit"
if ! npx tsc --noEmit; then
  red "✗ tsc --noEmit failed. Fix type errors before committing."
  exit 1
fi

# ──────────────────────────────────────────────────────────────────────
# 2. verify:columns on staged pipeline/api files
# ──────────────────────────────────────────────────────────────────────
STAGED_PIPELINE="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^src/(app/api/|lib/pipeline/)' || true)"
if [ -n "$STAGED_PIPELINE" ]; then
  echo "▶ verify:columns (pipeline/api files staged)"
  if ! npx tsx scripts/verify-columns.ts; then
    red "✗ verify:columns failed — schema drift detected."
    yellow "  See ARCHITECTURE_NOTES.md Schema Canonical Names Reference."
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────────
# 3. Secret-pattern grep on staged files (deny-list)
# ──────────────────────────────────────────────────────────────────────
STAGED_ALL="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if [ -n "$STAGED_ALL" ]; then
  # Skip .env.example legitimately containing placeholder strings
  STAGED_FOR_SECRETS="$(echo "$STAGED_ALL" | grep -v -E '^(\.env\.example|\.husky/|.*\.lock|.*\.md)$' || true)"
  if [ -n "$STAGED_FOR_SECRETS" ]; then
    # shellcheck disable=SC2086
    if echo "$STAGED_FOR_SECRETS" | xargs git show :./ 2>/dev/null | grep -E '(sk-proj-[A-Za-z0-9_-]{10,}|sbp_[a-f0-9]{40}|service_role.*eyJ[A-Za-z0-9._-]{20,})' >/dev/null 2>&1; then
      red "✗ Suspected secret pattern in staged content (sk-proj- / sbp_ / service-role JWT)."
      yellow "  Move the secret to .env.local (git-ignored) and rotate it."
      exit 1
    fi
  fi
fi

# ──────────────────────────────────────────────────────────────────────
# 4. ESLint on staged TS/TSX files
# ──────────────────────────────────────────────────────────────────────
STAGED_TS="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)"
if [ -n "$STAGED_TS" ]; then
  echo "▶ eslint (staged ts/tsx)"
  # shellcheck disable=SC2086
  if ! npx eslint $STAGED_TS; then
    red "✗ ESLint errors in staged files."
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────────
# 5. raw_articles immutability (H1 fix 3, docs/architecture/curation-
#    hardening-vra.md §9 acceptance criterion / Auditor persona finding).
#    raw_articles content columns (title/url/summary/content_hash) must
#    never be updated after insert — pipeline_status is the ONLY column
#    any code path may .update(). Project-wide invariant, not diff-scoped,
#    so it can't silently erode the next time someone adds a "fix a typo
#    in the title" feature. Permanent, runs every commit.
# ──────────────────────────────────────────────────────────────────────
echo "▶ raw_articles immutability check"
if grep -rn '\.from("raw_articles")\s*\.update(' src/ | grep -v pipeline_status | grep -q .; then
  red "✗ Found a raw_articles .update() call not scoped to pipeline_status only."
  yellow "  raw_articles content columns must never be updated after insert."
  exit 1
fi

green "✓ pre-commit gates passed"
