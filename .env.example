# ════════════════════════════════════════════════════════════════════
# ForgeMinds — Environment Variables (.env.example)
# ════════════════════════════════════════════════════════════════════
# Copy to .env.local for local dev. Set in Vercel for production.
# NEVER commit .env.local — it's in .gitignore.
#
# Variables grouped by phase. Set them as you reach each phase.
# Anything marked PUBLIC can ship in browser bundle.
# Anything else is SERVER-ONLY (NEXT_PUBLIC_ prefix forbidden).
# ════════════════════════════════════════════════════════════════════


# ═══ 🔴 PHASE 0 — REQUIRED NOW ═══════════════════════════════════════
# These must be set to deploy and run the app.

# Supabase (PUBLIC — safe in browser, RLS-gated)
NEXT_PUBLIC_SUPABASE_URL=https://ymgbjtgczgnooscigplb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SERVER ONLY — bypasses RLS for cron + admin)
SUPABASE_SERVICE_ROLE_KEY=

# Cron auth (server-only secret; protects /api/cron/* endpoints)
# Generate: openssl rand -base64 32
# ⚠️ MUST equal the Supabase vault secret `cron_secret` (seeded via
# vault.create_secret) — the pg_cron dispatcher sends that vault value as
# `Authorization: Bearer <cron_secret>`; if the host env CRON_SECRET
# differs, EVERY cron route returns 401 and the pipeline silently stalls.
CRON_SECRET=

# App URL (for redirects, OAuth callbacks, email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ═══ 🟡 PHASE 1 — INGEST + SCORING ═══════════════════════════════════

# Gemini Flash — bulk article scoring (gemini-2.5-flash: $0.30/M in,
# $2.50/M out; free tier generous). Code reads GEMINI_API_KEY
# (src/lib/ai/providers/gemini.ts) — this var was previously misnamed
# GOOGLE_AI_API_KEY here, which left the score/categorize pipeline dead
# for anyone who followed this file. Fixed 2026-06-04.
# Get: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Finnhub — stock quotes, fundamentals (free tier 60 calls/min)
# Get: https://finnhub.io/register
FINNHUB_API_KEY=

# Resend — transactional email digests (free 3k/mo)
# Get: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=briefs@forgeminds.app

# Grok / xAI — social posts, video prompts
# Get: https://console.x.ai
XAI_API_KEY=


# ═══ 🟡 PHASE 1.5 — REDDIT OAUTH (free, biggest unlock) ══════════════

# Get: https://www.reddit.com/prefs/apps (create "script" type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3000/api/oauth/reddit/callback


# ═══ 🟢 PHASE 2 — DEEP RESEARCH + EMBEDDINGS ═════════════════════════

# Claude — Haiku (briefs) + Sonnet (deep research)
# Get: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — embeddings ONLY (text-embedding-3-small, $0.02/M)
# Get: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Perplexity — live web research
# Get: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Alpaca — market data + paper trading API
# Get: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpha Vantage — technical indicators (free 25/day)
# Get: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Benzinga (paid only, ~$300+/mo) — leave empty unless you have a deal.
# Fetcher only runs for users with an active benzinga source row.
BENZINGA_API_KEY=


# ═══ 🟢 PHASE 3 — OAUTH PROVIDERS + MONETIZATION ═════════════════════

# X / Twitter (paid API, but you have credits)
# Get: https://developer.x.com/en/portal/dashboard
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/oauth/x/callback

# Google OAuth (used for YouTube subscriptions API)
# Get: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Discord (free, OAuth + bot)
# Get: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Stripe — billing for Builder/Architect tiers
# Get: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# IFTTT — social posting bridge (V1) — free tier limited; Pro $5/mo
IFTTT_KEY=
IFTTT_EVENT_X=
IFTTT_EVENT_FB=


# ═══ 🔵 BYOS — USER-PROVIDED, NOT PLATFORM-LEVEL ═════════════════════
# These are NOT set in Vercel. They're entered by users in Settings →
# External Subscriptions and stored encrypted in `external_subscriptions` table.
# Examples (don't set here):
#   - WSJ / NYT / Bloomberg session cookies
#   - Substack premium subscription cookies
#   - Readwise API key (their account)
#   - Feedly Pro+ API key (their account)
#   - Seeking Alpha Premium cookies


# ═══ ❌ NOT NEEDED ═══════════════════════════════════════════════════
# LinkedIn — restrictive API; we use OAuth scopes for 1st-degree only
# Hostinger / AWS / GCP / Replit — not platform integrations
# Bloomberg Terminal — not realistic for V1 ($24k/yr/seat)
