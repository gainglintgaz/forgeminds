# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI scratch files (linked-project, pooler-url, version pins)
supabase/.temp/

# auto-generated session reports (post-session-enforcer hook)
SESSION_DEBRIEF.md
CHANGELOG.md
STATUS_REPORT.md
WEEKLY_INSIGHTS.md

# playwright test artifacts
/test-results/
/playwright-report/

# alpha recruiting — private (contains real user names/contacts in time)
docs/alpha/
/blob-report/
/playwright/.cache/
