{
  "name": "forgeminds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:db": "tsx scripts/verify-db.ts",
    "verify:columns": "tsx scripts/verify-columns.ts",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "verify:honest-strings": "tsx scripts/verify-honest-strings.ts",
    "verify:env-vars": "tsx scripts/verify-env-vars.ts",
    "verify:phase-0": "tsx scripts/verify-phase-0.ts",
    "verify:phase-0:no-e2e": "tsx scripts/verify-phase-0.ts --skip-e2e",
    "verify:cron-routes": "tsx scripts/verify-cron-routes.ts",
    "verify:pipeline-flow": "tsx scripts/verify-pipeline-flow.ts",
    "verify:phase-1": "tsx scripts/verify-phase-1.ts",
    "verify:phase-1:no-e2e": "tsx scripts/verify-phase-1.ts --skip-e2e",
    "verify:phase-1:dev": "tsx scripts/verify-phase-1.ts --skip-e2e --skip-pipeline-flow",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@react-email/components": "^0.0.32",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.11.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "husky": "^9.1.6",
    "supabase": "^2.90.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
